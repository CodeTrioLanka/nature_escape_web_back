{
    "info": {
        "name": "User Activity Logging System",
        "description": "API endpoints for the user activity logging system",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"your-password\"\n}"
                        },
                        "url": {
                            "raw": "http://localhost:5000/api/auth/login",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Current User (/me)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:5000/api/auth/me",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "auth",
                                "me"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Logs",
            "item": [
                {
                    "name": "Get All Logs",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:5000/api/logs",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "logs"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Logs with Pagination",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:5000/api/logs?page=1&limit=10",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "logs"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Logs by Action",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:5000/api/logs?action=CREATE_PACKAGE",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "logs"
                            ],
                            "query": [
                                {
                                    "key": "action",
                                    "value": "CREATE_PACKAGE"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Logs by User ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:5000/api/logs?userId=YOUR_USER_ID",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "logs"
                            ],
                            "query": [
                                {
                                    "key": "userId",
                                    "value": "YOUR_USER_ID",
                                    "description": "Replace with actual user ID"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Logs by Date Range",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:5000/api/logs?startDate=2026-02-01&endDate=2026-02-03",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "logs"
                            ],
                            "query": [
                                {
                                    "key": "startDate",
                                    "value": "2026-02-01"
                                },
                                {
                                    "key": "endDate",
                                    "value": "2026-02-03"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Log Statistics",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:5000/api/logs/stats",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "logs",
                                "stats"
                            ]
                        }
                    }
                },
                {
                    "name": "Cleanup Old Logs (90 days)",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:5000/api/logs/cleanup?days=90",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "logs",
                                "cleanup"
                            ],
                            "query": [
                                {
                                    "key": "days",
                                    "value": "90"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Test Actions (Generate Logs)",
            "item": [
                {
                    "name": "Create Package (Generates Log)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"data\": \"{\\\"packageName\\\":\\\"Test Package\\\",\\\"slug\\\":\\\"test-package-{{$timestamp}}\\\",\\\"hero\\\":{\\\"title\\\":\\\"Test\\\",\\\"subtitle\\\":\\\"Testing\\\"},\\\"overview\\\":{\\\"duration\\\":\\\"1 Day\\\",\\\"description\\\":\\\"Test\\\"}}\"\n}"
                        },
                        "url": {
                            "raw": "http://localhost:5000/api/packages",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "packages"
                            ]
                        }
                    }
                },
                {
                    "name": "Update Package (Generates Log)",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"data\": \"{\\\"packageName\\\":\\\"Updated Test Package\\\"}\"\n}"
                        },
                        "url": {
                            "raw": "http://localhost:5000/api/packages/PACKAGE_ID",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "packages",
                                "PACKAGE_ID"
                            ]
                        }
                    }
                },
                {
                    "name": "Delete Package (Generates Log)",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:5000/api/packages/PACKAGE_ID",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "packages",
                                "PACKAGE_ID"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}